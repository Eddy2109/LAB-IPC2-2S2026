@model Semana11.Models.Producto[]

<h1>Productos</h1>

<a href="/Productos/Crear">
    Crear producto
</a>

<br />
<br />

@if (Model.Length == 0)
{
    <p>No hay productos registrados.</p>
}
else
{
    <table border="1" cellpadding="8">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Precio</th>
                <th>Acciones</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var producto in Model)
            {
                <tr>
                    <td>@producto.Id</td>

                    <td>@producto.Nombre</td>

                    <td>
                        Q @producto.Precio
                    </td>

                    <td>
                        <a href="/Productos/Detalle/@producto.Id">
                            Ver
                        </a>

                        |

                        <a href="/Productos/Editar/@producto.Id">
                            Editar
                        </a>

                        |

                        <form
                            method="post"
                            action="/Productos/Eliminar/@producto.Id"
                            style="display:inline;">

                            <button type="submit">
                                Eliminar
                            </button>

                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}